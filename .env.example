# Local development environment. Copy to .env (gitignored): cp .env.example .env
# FAKE VALUES ONLY — this file is committed. Real secrets live in AWS Secrets
# Manager and are injected by ECS; they never appear in any file (SPEC §11).

# Dummy credentials for the local emulators (DynamoDB Local, ElasticMQ, S3Mock).
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
