# Local development environment. Copy to .env (gitignored): cp .env.example .env
# FAKE VALUES ONLY — this file is committed. Real secrets live in AWS Secrets
# Manager and are injected by ECS; they never appear in any file (SPEC §11).

APP_ENV=local
LOG_LEVEL=info

# Dummy credentials and endpoints for the local emulators (docker-compose.yml).
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_ENDPOINT_URL_SQS=http://localhost:9324
AWS_ENDPOINT_URL_S3=http://localhost:9090

# Resource names (created by `shortenerctl local-init`; Terraform in AWS).
LINKS_TABLE=shortener-local-links
ANALYTICS_TABLE=shortener-local-analytics
CLICK_QUEUE_NAME=shortener-local-click-events
CLICK_DLQ_NAME=shortener-local-click-events-dlq
CLICK_QUEUE_URL=http://localhost:9324/000000000000/shortener-local-click-events
EVENTS_BUCKET=shortener-local-events

# Valkey: standalone, no TLS, no auth locally (AWS: cluster + TLS + IAM).
CACHE_ADDR=localhost:6379
CACHE_MODE=standalone
CACHE_AUTH=none
CACHE_TLS=false
# Only used when CACHE_AUTH=iam:
# CACHE_USER=shortener-dev-app
# CACHE_NAME=shortener-dev

# redirect service
CLIENT_IP_SOURCE=remote_addr
# Fake salt for local use only (AWS: Secrets Manager shortener/{env}/visitor-hash-salt).
VISITOR_HASH_SALT=local-development-salt-not-a-real-secret
CLICK_BUFFER=10000
CLICK_FLUSH_INTERVAL=1s

# api service
BASE_URL=http://localhost:8080
BLOCKED_HOSTS=
KEY_BLOCK_SIZE=1000
# Non-secret Sqids alphabet (shuffled); changing it after launch changes future codes.
SQIDS_ALPHABET=O7mH0bSxUPJnNZefjW25TzIALs3iX1kcRdMa8QD9hgKY4rEqlVyv6wGFoutBpC
# safebrowsing | fake | noop. The fake flags URLs containing malware.testing.google.test.
SCANNER=fake
# Only used when SCANNER=safebrowsing (AWS: Secrets Manager shortener/{env}/safe-browsing-api-key).
# SAFE_BROWSING_API_KEY=
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_READ_PER_MIN=300
AUTH_CACHE_TTL=60s

# worker service (docker-compose.yml shortens WORKER_FLUSH_INTERVAL to 10s locally)
WORKER_FLUSH_INTERVAL=60s
WORKER_MAX_BATCH_BYTES=5242880
WORKER_CONCURRENCY=10
WORKER_WAIT_SECONDS=20
# Batched counting (ADR-0024): clicks wait at most this long for their counting transaction.
WORKER_COUNT_INTERVAL=2s
WORKER_COUNT_MAX_EVENTS=1000
# Shared
METRICS_FLUSH_INTERVAL=10s
SHUTDOWN_TIMEOUT=20s
