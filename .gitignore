# --- Secrets & local env (SPEC §11.2) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.example.tfvars
!example.tfvars
!infra/envs/*/deploy.tfvars
backend.hcl
!backend.hcl.example
# Saved plans and their logs/summaries hold every variable value (including
# alert_email), account IDs and resource attributes: never commit them.
tfplan*
*.tfplan
plan*.log
plan*summary.txt
crash.log
crash.*.log
.terraform.tfstate.lock.info
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Tooling / build output ---
/.tools/
/bin/
/dist/
/coverage/
/tests/load/results/
*.out
*.test
tools/node_modules/
node_modules/
__pycache__/

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store

# Lock files are committed for root modules only (bootstrap, envs/*).
infra/modules/**/.terraform.lock.hcl

# Registry credentials (docker/crane login) if a tool is ever pointed at the repo.
.docker/

# Local credentials and agent state; never committed.
.aws/
.codex/
.agents/
.claude/settings.local.json
